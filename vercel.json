{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.spinsite.app"
        }
      ],
      "destination": "https://spinsite.app/$1",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "spinsite.vercel.app"
        }
      ],
      "destination": "https://spinsite.app/",
      "permanent": true
    },
    {
      "source": "/s/(.*)",
      "has": [
        {
          "type": "host",
          "value": "spinsite.vercel.app"
        }
      ],
      "destination": "https://spinsite.app/s/$1",
      "permanent": true
    },
    {
      "source": "/r/(.*)",
      "has": [
        {
          "type": "host",
          "value": "spinsite.vercel.app"
        }
      ],
      "destination": "https://spinsite.app/r/$1",
      "permanent": true
    },
    {
      "source": "/api/auth/login",
      "has": [
        {
          "type": "host",
          "value": "spinsite.vercel.app"
        }
      ],
      "destination": "https://spinsite.app/api/auth/login",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(?:[^.]+\\.)?sites\\.spinsite\\.app"
        }
      ],
      "destination": "/api/index"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/s/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/r/(.*)",
      "destination": "/api/index"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ],
      "missing": [
        {
          "type": "host",
          "value": "(?:[^.]+\\.)?sites\\.spinsite\\.app"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/cleanup",
      "schedule": "0 4 * * *"
    }
  ],
  "functions": {
    "api/index.py": {
      "includeFiles": "api/_core/**"
    }
  }
}
