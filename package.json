{
  "name": "site-runner",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "dev:api": "set -a; [ -f .env.auth.local ] && . ./.env.auth.local; set +a; uvicorn api.index:app --reload --port 8000",
    "dev:uc": "set -a; [ -f .env.auth.local ] && . ./.env.auth.local; set +a; CONTENT_ONLY=1 uvicorn api.index:app --reload --port 8001",
    "test": "pytest -q"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "idb": "^8.0.4",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "typescript": "^5"
  }
}
