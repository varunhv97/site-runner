# Copy to .env.auth.local for local dev (loaded by `npm run dev:api`). Set the same names in Vercel.

# Google sign-in (Google Cloud > Google Auth Platform > Clients). When unset, sign-in is off:
# sharing is anonymous locally and refused in production.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Signs the session cookie. Any long random string: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Comma-separated Google emails that may unpublish any site, review abuse reports (/admin) and ban accounts.
ADMIN_EMAILS=
# Optional: email or URL shown to banned accounts ("Contact ... if you think this is a mistake").
# Default: the GitHub issues page.
# ABUSE_CONTACT=abuse@spinsite.app

# Email each new abuse report (sent with Resend; reports are stored for /admin either way).
# REPORT_EMAIL=abuse@spinsite.app
# RESEND_API_KEY=
# MAIL_FROM=Site Runner <reports@spinsite.app>

# Postgres for metadata. Set by the Neon integration (pooled URL). Unset locally = SQLite in ./.data
# DATABASE_URL=postgres://user:pass@host-pooler.neon.tech/db?sslmode=require

# Vercel Blob. Set by Vercel when a Blob store is connected; unset locally = files in ./.data
# BLOB_READ_WRITE_TOKEN=
# Access mode of that store: private (default; files only reachable through this app) or public.
# BLOB_ACCESS=private

# Guards the daily cleanup cron (/api/cron/cleanup). Vercel sends it as a Bearer token.
CRON_SECRET=

# Storage per account in MB (unique files across its shared sites; may be fractional). Default 250.
# STORAGE_QUOTA_MB=250

# Storage for all accounts together in MB (uploads past it are refused; an alert email past 80%). Default 900.
# GLOBAL_STORAGE_LIMIT_MB=900

# Scan uploads for phishing, seed-phrase grabs and miners, holding matches for an admin's review. Default on.
# UPLOAD_SCAN=on

# The app's public origin, used in share links, sign-in and the origin check. Required in production.
# Locally it defaults to the request's host (share links) and http://localhost:3000 (the preview boot page).
# PUBLIC_BASE_URL=https://spinsite.app

# Where user content is served: <site id>.<domain> for shared sites, p-<local id>.<domain> for previews.
# Never the app's own domain. https, except *.localhost (http, for local dev). Required in production.
# Default locally: usercontent.localhost:8001 (npm run dev:uc). Production: sites.spinsite.app
# USERCONTENT_BASE_DOMAIN=usercontent.localhost:8001

# Set to 1 on the deployment that only serves user content (the second Vercel project): no app routes at all.
# CONTENT_ONLY=1
