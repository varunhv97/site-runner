# Copy to .env.auth.local for local dev (loaded by `npm run dev:api`). Set the same names in Vercel.

# Google sign-in (Google Cloud > Google Auth Platform > Clients). When unset, sign-in is off:
# sharing is anonymous locally and refused in production.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Signs the session cookie. Any long random string: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Comma-separated Google emails that may unpublish any site (takedowns).
ADMIN_EMAILS=

# Vercel Blob. Set by Vercel when a Blob store is connected; unset locally = files in ./.data
# BLOB_READ_WRITE_TOKEN=

# Optional: the public origin used in share links (defaults to the request's host).
# PUBLIC_BASE_URL=https://spinsite.vercel.app
